@article{chen2026oralsense,
  abbr         = {TMC 2026},
  title        = {OralSense: Versatile, Accurate Oral Sensing With Customizable Magnets},
  author       = {Chen, Zhenyu and Wang, Jike and Huang, Ye and Chen, Xiaomeng and Wang, Xinbing and Chen, Dongyao},
  journal      = {IEEE Transactions on Mobile Computing},
  year         = {2026},
  month        = sep,
  volume       = {25},
  number       = {9},
  pages        = {14943--14958},
  publisher    = {IEEE},
  doi          = {10.1109/TMC.2026.3688797},
  url          = {https://doi.org/10.1109/TMC.2026.3688797},
  abstract     = {Sensing oral behaviors is essential for preserving oral health, facilitating privacy-protective interaction, and promoting overall physical well-being. However, oral sensing applications always demand dedicated platforms. This requirement leads to diverse sensing platform designs, thus impeding the usability of oral sensing technologies. This paper tackles this problem by granting customizable capability to oral-sensing platforms. We introduce OralSense, a wearable and highly customizable oral sensing system at a low cost. Specifically, OralSense uses magnetic sensing to track the custom-designed magnetic front ends to sense various oral behaviors. We examined OralSense's usability with two representative real-world applications, i.e., toothbrushing monitoring and silent speech recognition. Our empirical studies revealed an overall recognition accuracy of 93.8\% for 16 tooth surfaces among 21 participants and 95.2\% for 71 words and commands, including 40 English words and six tongue interaction motions, among six participants. To further validate the usability of OralSense, we conducted a comprehensive survey involving 150 online respondents. The results demonstrated a high level of acceptance for OralSense's design among a diverse group of participants. We also consulted with three clinicians to gain professional insights, which highlighted the potential of OralSense for practical application in both home and clinical settings.},
  additional_info = {, 25(9), 14943–14958},
  website      = {https://flux.chendy.tech/projects/oralsense.html},
  preview      = {OralSense_fig.jpg},
  bibtex_show  = {true},
  selected     = {true}
}

@inproceedings{wang2026mutouch,
  abbr         = {PerCom 2026},
  title        = {μTouch: Enabling Accurate, Lightweight Self-Touch Sensing with Passive Magnets},
  author       = {Wang, Siyuan and Li, Ke and Huang, Jingyuan and Wang, Jike and Zhang, Cheng and Sample, Alanson and Chen, Dongyao},
  booktitle    = {2026 IEEE International Conference on Pervasive Computing and Communications (PerCom)},
  year         = {2026},
  month        = mar,
  pages        = {1--10},
  publisher    = {IEEE},
  doi          = {10.1109/PerCom67906.2026.11524446},
  url          = {https://doi.org/10.1109/PerCom67906.2026.11524446},
  abstract     = {Self-touch gestures (e.g., nuanced facial touches and subtle finger scratches) provide rich insights into human behaviors, from hygiene practices to health monitoring. However, existing approaches fall short in detecting such micro gestures due to their diverse movement patterns. This paper presents μTouch, a novel magnetic sensing platform for self-touch gesture recognition. μTouch features (1) a compact hardware design with low-power magnetometers and magnetic silicon, (2) a lightweight semi-supervised framework requiring minimal user data, and (3) an ambient field detection module to mitigate environmental interference. We evaluated μTouch in two representative applications in user studies with 11 and 12 participants. μTouch only requires three-second fine-tuning data for each gesture, and new users need less than one minute before starting to use the system. μTouch can distinguish eight different face-touching behaviors with an average accuracy of 93.41\%, and reliably detect body-scratch behaviors with an average accuracy of 94.63\%. μTouch demonstrates accurate and robust sensing performance even after a month, showcasing its potential as a practical tool for hygiene monitoring and dermatological health applications.},
  arxiv        = {2601.22864},
  pdf          = {muTouch_PerCom26.pdf},
  code         = {https://github.com/Wangmerlyn/muTouch},
  website      = {https://wangmerlyn.github.io/muTouch/},
  preview      = {muTouch_fig.png},
  bibtex_show  = {true},
  selected     = {false}
}

